# Copy this file to .env and fill in your own values. Never commit .env.

# Your Atlas connection string. The DATABASE NAME is the part after the host
# and before the "?" (here: plantSwapShelf). Keep the database name, but use
# your own username, password and cluster URL.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/plantSwapShelf?retryWrites=true&w=majority

# The port this server listens on.
PORT=3001
